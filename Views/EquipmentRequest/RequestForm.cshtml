@model EquipmentRequest

<div>
  <form asp-action="RequestForm" asp-controller="EquipmentRequest" method="post">
    <div>
      <!--User details-->
      <div class="form-group">
        <label asp-for="User.Name">Username:</label>
        <input asp-for="User.Name" class="form-control" />
        <span asp-validation-for="User.Name" class="text-danger"></span>
      </div>
      <div class="form-group">
        <label asp-for="User.Email">Email:</label>
        <input asp-for="User.Email" class="form-control" />
        <span asp-validation-for="User.Email" class="text-danger"></span>
      </div>
      <div class="form-group">
        <label asp-for="User.PhoneNumber">Phone number:</label>
        <input asp-for="User.PhoneNumber" type="tel" class="form-control" />
        <span asp-validation-for="User.PhoneNumber" class="text-danger"></span>
      </div>
      <div class="form-group">
        <label asp-for="User.Role">Role:</label>
        <select asp-for="User.Role" class="form-control" asp-items="Html.GetEnumSelectList<Role>()">
          <option value="">Select a role</option>
        </select>
        <span asp-validation-for="EquipmentType" class="text-danger"></span>
      </div>
      <!--Equipment details-->
      <div class="form-group">
        <label asp-for="EquipmentType">Equipment Type:</label>
        <select asp-for="EquipmentType" class="form-control" asp-items="Html.GetEnumSelectList<EquipmentType>()">
          <option value="">Select an equipment type</option>
        </select>
        <span asp-validation-for="EquipmentType" class="text-danger"></span>
      </div>
      <div class="form-group">
        <label asp-for="RequestDetails">Request Details:</label>
        <input asp-for="RequestDetails" class="form-control" />
        <span asp-validation-for="RequestDetails" class="text-danger"></span>
      </div>
      <div class="form-group">
        <label asp-for="Duration">Loan Druation:</label>
        <input asp-for="Duration" type="number" class="form-control" />
        <span asp-validation-for="Duration" class="text-danger"></span>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
  </form>
</div>
